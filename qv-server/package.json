{
  "name":        "qv-server",
  "version":     "4.0.0-alpha",
  "description": "QuantumVault Sovereign REST API — zero npm dependencies",
  "type":        "module",
  "main":        "server-sovereign.mjs",
  "scripts": {
    "start":        "node server-sovereign.mjs",
    "start:legacy": "node server.mjs",
    "test":         "node --test --test-timeout=30000 test/auth.test.mjs test/integration.auth.test.mjs",
    "test:unit":    "node --test test/auth.test.mjs",
    "test:it":      "node --test --test-timeout=30000 test/integration.auth.test.mjs",
    "mint-token":   "node -e \"import('./auth.mjs').then(m=>{const t=m.mintAdminToken();console.log('QV_ADMIN_TOKEN='+t.token);console.log('QV_ADMIN_TOKEN_SHA256='+t.sha256)})\""
  },
  "dependencies": {},
  "engines": { "node": ">=18.0.0" },
  "license": "ISC"
}
